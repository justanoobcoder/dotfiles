#!/usr/bin/env python3

# Cre: https://github.com/AtefR

import argparse
import atexit
import json
import os
import signal
import subprocess
import sys
import time

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
STATE_DIR = os.path.join(RUNTIME_DIR, "niri-sticky-window")
PID_FILE = os.path.join(STATE_DIR, "pid")
WIN_FILE = os.path.join(STATE_DIR, "window")


def _run(cmd):
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "command failed")
    return proc.stdout


def _json_from_niri(*args):
    out = _run(["niri", "msg", "--json", *args])
    lines = [line for line in out.splitlines() if line.strip()]
    if not lines:
        return None
    return json.loads(lines[-1])


def _unwrap_ok(payload):
    if isinstance(payload, dict) and "Err" in payload:
        raise RuntimeError(payload["Err"])
    if isinstance(payload, dict) and "Ok" in payload:
        return payload["Ok"]
    return payload


def _extract_list(payload, key):
    if isinstance(payload, dict) and key in payload:
        items = payload.get(key)
        return items or []
    if isinstance(payload, list):
        return payload
    return []


def _get_focused_workspace_active_window_id():
    payload = _json_from_niri("workspaces")
    payload = _unwrap_ok(payload)
    workspaces = _extract_list(payload, "Workspaces")
    if not workspaces:
        return None
    focused = next((w for w in workspaces if w.get("is_focused")), None)
    if not focused:
        focused = next((w for w in workspaces if w.get("is_active")), None)
    if not focused:
        return None
    return focused.get("active_window_id")


def _get_windows():
    payload = _json_from_niri("windows")
    payload = _unwrap_ok(payload)
    return _extract_list(payload, "Windows")


def _read_window_id():
    try:
        with open(WIN_FILE, "r", encoding="utf-8") as f:
            return int(f.read().strip())
    except (FileNotFoundError, ValueError):
        return None


def _choose_window_from_windows(windows):
    if not windows:
        return None

    for w in windows:
        if w.get("is_focused"):
            return w.get("id")

    best = None
    best_ts = None
    for w in windows:
        ts = w.get("focus_timestamp")
        if not ts:
            continue
        ts_key = (ts.get("secs", 0), ts.get("nanos", 0))
        if best_ts is None or ts_key > best_ts:
            best_ts = ts_key
            best = w
    if best:
        return best.get("id")

    floating = [w for w in windows if w.get("is_floating")]
    if len(floating) == 1:
        return floating[0].get("id")

    if len(windows) == 1:
        return windows[0].get("id")

    return None


def get_focused_window_id():
    payload = _json_from_niri("focused-window")
    payload = _unwrap_ok(payload)

    if isinstance(payload, dict):
        window = payload.get("FocusedWindow")
        if window:
            return window.get("id")
        if "id" in payload:
            return payload.get("id")

    window_id = _get_focused_workspace_active_window_id()
    if window_id:
        return window_id

    windows = _get_windows()
    chosen = _choose_window_from_windows(windows)
    if chosen:
        return chosen

    stored = _read_window_id()
    if stored and any(w.get("id") == stored for w in windows):
        return stored

    return None


def move_window_to_workspace(window_id, workspace_idx):
    # Avoid focus stealing; keep it on the current workspace.
    _run(
        [
            "niri",
            "msg",
            "action",
            "move-window-to-workspace",
            "--window-id",
            str(window_id),
            str(workspace_idx),
            "--focus",
            "false",
        ]
    )


def move_window_to_floating(window_id):
    _run(["niri", "msg", "action", "move-window-to-floating", "--id", str(window_id)])


def pid_running(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_pid():
    try:
        with open(PID_FILE, "r", encoding="utf-8") as f:
            return int(f.read().strip())
    except (FileNotFoundError, ValueError):
        return None


def write_pid(pid):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(PID_FILE, "w", encoding="utf-8") as f:
        f.write(str(pid))


def write_window_id(window_id):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(WIN_FILE, "w", encoding="utf-8") as f:
        f.write(str(window_id))


def cleanup_state():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r", encoding="utf-8") as f:
                if f.read().strip() == str(os.getpid()):
                    os.remove(PID_FILE)
        if os.path.exists(WIN_FILE):
            os.remove(WIN_FILE)
    except OSError:
        pass


def run_daemon(window_id):
    workspaces = {}
    window_workspace_id = None

    def handle_exit(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, handle_exit)
    signal.signal(signal.SIGINT, handle_exit)
    atexit.register(cleanup_state)

    # Start event stream.
    proc = subprocess.Popen(
        ["niri", "msg", "--json", "event-stream"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    if not proc.stdout:
        raise RuntimeError("failed to start niri event stream")

    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue

        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue

        # Ignore the initial Reply::Ok(Handled) or errors from the stream.
        if isinstance(payload, dict) and ("Ok" in payload or "Err" in payload):
            if "Err" in payload:
                raise RuntimeError(payload["Err"])
            continue

        if not isinstance(payload, dict) or len(payload) != 1:
            continue

        event, data = next(iter(payload.items()))

        if event == "WorkspacesChanged":
            workspaces = {w["id"]: w for w in data.get("workspaces", [])}
            focused = next(
                (w for w in workspaces.values() if w.get("is_focused")),
                None,
            )
            if focused and focused.get("id") != window_workspace_id:
                idx = focused.get("idx")
                if idx is not None:
                    move_window_to_workspace(window_id, idx)
        elif event == "WorkspaceActivated":
            if data.get("focused"):
                ws = workspaces.get(data.get("id"))
                if ws:
                    idx = ws.get("idx")
                    if idx is not None and ws.get("id") != window_workspace_id:
                        move_window_to_workspace(window_id, idx)
        elif event == "WindowsChanged":
            for w in data.get("windows", []):
                if w.get("id") == window_id:
                    window_workspace_id = w.get("workspace_id")
                    break
        elif event == "WindowOpenedOrChanged":
            w = data.get("window")
            if w and w.get("id") == window_id:
                window_workspace_id = w.get("workspace_id")
        elif event == "WindowClosed":
            if data.get("id") == window_id:
                break

    try:
        proc.terminate()
    except OSError:
        pass


def start(window_id, make_floating):
    if make_floating:
        move_window_to_floating(window_id)

    os.makedirs(STATE_DIR, exist_ok=True)
    write_window_id(window_id)

    proc = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "run", str(window_id)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    write_pid(proc.pid)


def stop():
    pid = read_pid()
    if pid and pid_running(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
        if os.path.exists(WIN_FILE):
            os.remove(WIN_FILE)
    except OSError:
        pass


def main():
    parser = argparse.ArgumentParser(
        description="Toggle sticky window following the focused workspace."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    toggle_parser = subparsers.add_parser("toggle", help="Toggle sticky follow mode")
    toggle_parser.add_argument("--window-id", type=int, default=None)
    toggle_parser.add_argument(
        "--float", action="store_true", help="Move the window to floating layout first"
    )

    on_parser = subparsers.add_parser("on", help="Enable sticky follow mode")
    on_parser.add_argument("--window-id", type=int, default=None)
    on_parser.add_argument(
        "--float", action="store_true", help="Move the window to floating layout first"
    )

    subparsers.add_parser("off", help="Disable sticky follow mode")

    run_parser = subparsers.add_parser("run", help=argparse.SUPPRESS)
    run_parser.add_argument("window_id", type=int)

    args = parser.parse_args()

    if args.command == "off":
        stop()
        return

    if args.command == "run":
        run_daemon(args.window_id)
        return

    existing_pid = read_pid()
    if args.command == "toggle" and existing_pid and pid_running(existing_pid):
        stop()
        return

    window_id = args.window_id or get_focused_window_id()
    if not window_id:
        raise SystemExit("No focused window found.")

    start(window_id, args.float)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except Exception as exc:
        print(f"sticky-window: {exc}", file=sys.stderr)
        sys.exit(1)

