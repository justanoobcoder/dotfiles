layout {
    gaps 5

    center-focused-column "never"

    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.7; }

    struts {
    }
}
